# Supabase project (Dashboard → Project Settings → API). The publishable key is safe to expose:
# every table is protected by Row Level Security. No service-role key is used anywhere.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: force the origin used for seed image URLs (normally derived from the Host header).
# PUBLIC_BASE_URL=https://pinoystars-api.vercel.app
